<Window x:Class="VPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPrint — Virtual printer manager" Width="1270" Height="810"
        MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The printer navigation stays mounted; only changed rows are updated. -->
    <Border Background="{StaticResource SidebarBrush}">
      <Grid Margin="19,27,19,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4,0,0,43">
          <Grid Width="43" Height="43">
            <Border Background="#D8684A" CornerRadius="11"/>
            <Rectangle Width="25" Height="16" RadiusX="3" RadiusY="3" Fill="#F9F8F4"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,-4"/>
            <Rectangle Width="19" Height="13" Fill="#FFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,-19,0,0"/>
            <Rectangle Width="18" Height="12" Fill="#F2E4DC" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,17,0,0"/>
            <Rectangle Width="10" Height="2" Fill="#D8684A" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,19,0,0"/>
          </Grid>
          <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
            <TextBlock Text="VPrint" Foreground="White" FontWeight="Bold" FontSize="20"/>
            <TextBlock Text="PRINT WORKSPACE" Foreground="{StaticResource SidebarMutedBrush}"
                       FontSize="9" FontWeight="SemiBold" CharacterSpacing="1"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="WORKSPACE" Foreground="{StaticResource SidebarMutedBrush}"
                   FontWeight="SemiBold" FontSize="10" Margin="12,0,0,14"/>

        <Button Grid.Row="2" Click="AllJobs_Click" Background="#34403D" BorderThickness="0"
                Cursor="Hand" Padding="12,13" HorizontalContentAlignment="Stretch"
                ToolTip="Show print jobs from every virtual printer">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="9"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </ControlTemplate>
          </Button.Template>
          <DockPanel>
            <TextBlock Text="▤" Foreground="#F6E2D6" FontSize="17" Margin="0,0,12,0"/>
            <TextBlock Text="All print jobs" Foreground="#FFFFFF" FontWeight="SemiBold"
                       VerticalAlignment="Center" FontSize="13"/>
          </DockPanel>
        </Button>

        <Grid Grid.Row="3" Margin="0,32,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="12,0,12,8">
            <TextBlock Text="{Binding PrinterCount}" DockPanel.Dock="Right"
                       Foreground="{StaticResource SidebarMutedBrush}" FontSize="11"/>
            <TextBlock Text="YOUR PRINTERS" Foreground="{StaticResource SidebarMutedBrush}"
                       FontWeight="SemiBold" FontSize="10"/>
          </DockPanel>
          <ListBox Grid.Row="1" x:Name="PrinterList"
                   ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource PrinterListItem}"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding JobCount}"
                             Foreground="{StaticResource SidebarMutedBrush}" FontSize="11"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="▣" Foreground="#E9B0A0" Margin="0,0,12,0" FontSize="14"/>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                             FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <StackPanel Grid.Row="4">
          <Border Background="#283332" CornerRadius="10" Padding="13" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="LOCAL &amp; PRIVATE" Foreground="#DDE8E3"
                         FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="Your print history stays on this PC."
                         Foreground="{StaticResource SidebarMutedBrush}"
                         TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="VPrint 0.1  •  Windows 11" Foreground="{StaticResource SidebarMutedBrush}"
                     FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="31,29,31,27">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Print overview" Style="{StaticResource PageHeading}"/>
          <TextBlock Text="Manage your virtual printers and see what was printed."
                     Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"
                  Margin="0,0,9,0" AutomationProperties.Name="Refresh virtual printers"/>
          <Button Content="+  Add printer" Click="AddPrinter_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="3" Margin="0,27,0,21">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="19,17">
          <StackPanel>
            <TextBlock Text="VIRTUAL PRINTERS" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PrinterCount}" Foreground="{StaticResource InkBrush}"
                       FontWeight="SemiBold" FontSize="29" Margin="0,7,0,0"/>
            <TextBlock Text="Available in Windows" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0" Padding="19,17">
          <StackPanel>
            <TextBlock Text="PRINT JOBS TODAY" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource InkBrush}"
                       FontWeight="SemiBold" FontSize="29" Margin="0,7,0,0"/>
            <TextBlock Text="Completed on this PC" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="19,17">
          <StackPanel>
            <TextBlock Text="RECENT HISTORY" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding JobCount}" Foreground="{StaticResource InkBrush}"
                       FontWeight="SemiBold" FontSize="29" Margin="0,7,0,0"/>
            <TextBlock Text="Most recent 750 jobs" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Grid.Row="2" Background="#FFF4ED" BorderBrush="#F2DBCC"
              BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
        <DockPanel>
          <TextBlock Text="ⓘ" DockPanel.Dock="Left" FontSize="17" Foreground="#B7583B"
                     Margin="0,0,10,0"/>
          <TextBlock Text="PDF files are currently saved through Windows' Save As dialog. Automatic PDF capture and preview are not enabled in this version."
                     TextWrapping="Wrap" Foreground="#744D3F" FontSize="12"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Fill="#61A18F" Width="8" Height="8" Margin="0,0,11,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InkBrush}"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Enable history" Click="EnableHistory_Click"
                  Visibility="{Binding NeedsHistorySetup, Converter={StaticResource BooleanToVisibility}}"
                  Style="{StaticResource SecondaryButton}" Padding="11,6" FontSize="12"/>
        </Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentScope}" Foreground="{StaticResource InkBrush}"
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource MutedText}"
                       Margin="0,4,0,0"/>
          </StackPanel>
          <TextBox Grid.Column="1" Style="{StaticResource TextInputStyle}" Height="39"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Search by document name, printer or user"
                   AutomationProperties.Name="Search print jobs" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="Remove printer" Click="RemovePrinter_Click"
                  IsEnabled="{Binding HasSelectedPrinter}" Style="{StaticResource SecondaryButton}"
                  Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="JobsGrid" ItemsSource="{Binding VisibleJobs}"
                      Background="White" BorderThickness="0" HeadersVisibility="Column"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False"
                      RowHeight="48" ColumnHeaderHeight="44" SelectionMode="Single"
                      GridLinesVisibility="None" AlternatingRowBackground="#FAFBFA"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
              <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                  <Setter Property="Background" Value="#F9FAF9"/>
                  <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="Padding" Value="14,8"/>
                  <Setter Property="BorderThickness" Value="0,0,0,1"/>
                  <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                </Style>
                <Style TargetType="DataGridCell">
                  <Setter Property="Padding" Value="14,7"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="VerticalContentAlignment" Value="Center"/>
                  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                  <Setter Property="FontSize" Value="12"/>
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#FBEAE3"/>
                      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
                <Style TargetType="DataGridRow">
                  <Setter Property="BorderThickness" Value="0,0,0,1"/>
                  <Setter Property="BorderBrush" Value="#F0F1F0"/>
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="DOCUMENT" Binding="{Binding DocumentName}"
                                    Width="2*" MinWidth="160"/>
                <DataGridTextColumn Header="PRINTER" Binding="{Binding PrinterLabel}"
                                    Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="USER" Binding="{Binding UserName}"
                                    Width="*" MinWidth="95"/>
                <DataGridTextColumn Header="PAGES" Binding="{Binding PagesLabel}"
                                    Width="70"/>
                <DataGridTextColumn Header="PRINTED AT" Binding="{Binding PrintedLabel}"
                                    Width="155"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Visibility="{Binding IsVisibleHistoryEmpty, Converter={StaticResource BooleanToVisibility}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="320" IsHitTestVisible="False">
              <TextBlock Text="▤" Foreground="#D4A596" FontSize="40"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="No print jobs yet" Foreground="{StaticResource InkBrush}"
                         FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center"
                         Margin="0,13,0,6"/>
              <TextBlock Text="Create a virtual printer and print from any Windows app to see job details here."
                         Foreground="{StaticResource MutedBrush}" FontSize="12"
                         TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
