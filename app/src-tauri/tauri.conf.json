{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPrint",
  "version": "0.2.0",
  "identifier": "live.vprint.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VPrint — Virtual Printer Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 990,
        "minHeight": 660,
        "backgroundColor": "#F6F7F5",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
